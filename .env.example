# Server
PORT=3001

# OpenRouter (Get free API key from https://openrouter.ai)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# GitHub (Create token with repo scope)
GITHUB_TOKEN=ghp_your_github_token_here

# Monitor API Key (for GitHub Actions)
MONITOR_API_KEY=your_monitor_api_key
MONITOR_URL=http://localhost:3001
